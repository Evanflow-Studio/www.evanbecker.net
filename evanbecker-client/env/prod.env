# Public runtime config for www.evanbecker.net. Every value here is public: it is
# served to every browser in the page payload. Secrets never go in this file.
# Used by the homelab compose (docker-compose.production.yaml) and scripts/smoke-client-image.sh.
NUXT_PUBLIC_SITE_URL=https://www.evanbecker.net
NUXT_PUBLIC_INDEXABLE=true
NUXT_PUBLIC_API_URL=https://api.evanbecker.net
NUXT_PUBLIC_AUTH0_DOMAIN=evanbecker.us.auth0.com
NUXT_PUBLIC_AUTH0_CLIENT_ID=JOV7J3Qv3XzFD3xyQjDEW03PtaU8bpqc
NUXT_PUBLIC_AUTH0_AUDIENCE=api.evanbecker.net
NUXT_PUBLIC_AUTH0_REDIRECT_URI=https://www.evanbecker.net
