# Public runtime config for test.evanbecker.net. Every value here is public: it is
# served to every browser in the page payload. Secrets never go in this file.
# Used by scripts/smoke-client-image.sh; evanflow-infra's deploy sets the same values. The homelab
# compose doesn't read it: the homelab keeps the images it runs today until the cutover.
NUXT_PUBLIC_SITE_URL=https://test.evanbecker.net
NUXT_PUBLIC_INDEXABLE=false
NUXT_PUBLIC_API_URL=https://api-test.evanbecker.net
NUXT_PUBLIC_AUTH0_DOMAIN=dev-m3uiopcp.us.auth0.com
NUXT_PUBLIC_AUTH0_CLIENT_ID=2evqEjBNUmBVt6fNwcGkicfjNNrYsjV0
NUXT_PUBLIC_AUTH0_AUDIENCE=evanbecker.api
NUXT_PUBLIC_AUTH0_REDIRECT_URI=https://test.evanbecker.net
NUXT_PUBLIC_RECAPTCHA_SITE_KEY=6Lfb5pksAAAAAHnzNOV1DxBqF_EYU9UPVimOR6WZ
