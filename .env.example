# Docker Compose environment variables
# Copy to .env and fill in values

# Database
DB_NAME=evanbecker-db
Prod_DB_USER=EvanBecker
Prod_DB_PASSWORD=your-password-here

# .NET environment (Development, Production, Test)
ENVIRONMENT=Development

# Local Postgres for docker-compose.yaml. Any password you like; give the API the same
# value as PGPASSWORD (or a full connection string in user secrets). Never commit .env.
POSTGRES_PASSWORD=
